# Copy this to .env (gitignored) and fill in the real value.
#
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time (Expo's
# standard client-safe env var convention) — never put a real secret behind
# one of these. The Help & Support flow's actual secret (RESEND_API_KEY) is
# NOT a client var at all: it lives only in Vercel's project settings for
# api/contact.ts, never in this repo. See src/data/contact.ts and
# api/contact.ts for the full send path.

# The deployed URL of api/contact.ts once this repo (or just that function)
# has been deployed to Vercel, e.g. https://your-project.vercel.app/api/contact
EXPO_PUBLIC_CONTACT_API_URL=

# Public URLs for Setting -> Terms of Service's two rows (TermsOfServiceScreen.tsx).
# Both are required before App Store / Play submission — a public Privacy
# Policy URL in particular is a hard requirement of both stores. See
# legal/terms-of-service.md and legal/privacy-policy.md for drafted text
# ready to publish (e.g. as a public Notion page) and paste the resulting
# URLs in here. Until set, tapping either row shows a "not published yet"
# alert instead of opening nothing.
EXPO_PUBLIC_TERMS_OF_USE_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
