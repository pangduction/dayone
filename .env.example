# Copy this to .env (gitignored) and fill in the real value.
#
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time (Expo's
# standard client-safe env var convention) — never put a real secret behind
# one of these. The Help & Support flow's actual secret (RESEND_API_KEY) is
# NOT a client var at all: it lives only in Vercel's project settings for
# api/contact.ts, never in this repo. See src/data/contact.ts and
# api/contact.ts for the full send path.

# The deployed URL of api/contact.ts once this repo (or just that function)
# has been deployed to Vercel, e.g. https://your-project.vercel.app/api/contact
EXPO_PUBLIC_CONTACT_API_URL=

# Public URLs for Setting -> Terms of Service's two rows (TermsOfServiceScreen.tsx).
# Both are required before App Store / Play submission — a public Privacy
# Policy URL in particular is a hard requirement of both stores. See
# legal/terms-of-service.md and legal/privacy-policy.md for drafted text
# ready to publish (e.g. as a public Notion page) and paste the resulting
# URLs in here. Until set, tapping either row shows a "not published yet"
# alert instead of opening nothing.
EXPO_PUBLIC_TERMS_OF_USE_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Firebase Authentication (Login-1, Figma node 3177:2606). This is a client
# config, not a secret — every Firebase web/app project ships it inside its
# own bundle — so it's fine as a plain EXPO_PUBLIC_ var. From the Firebase
# console: create a project (free), add a Web app to it, and copy these
# values from Project settings -> General -> "Your apps" -> SDK setup.
# Leaving all of these empty is a supported state during development:
# RootNavigator falls back to no login-gate at all until a real project is
# configured (see its own doc comment) — the rest of the app works exactly
# as before.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (LoginScreen.tsx's "Continue with Google", via
# expo-auth-session). In the Firebase console, Authentication -> Sign-in
# method -> enable Google — this auto-creates a Web client ID (also visible
# in Google Cloud Console -> APIs & Services -> Credentials). The iOS/Android
# client IDs are optional extras for native-feeling sign-in in a production
# build; the Web client ID alone is enough to test in a dev client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
